# Copy to .env locally. Never commit real credentials.
LLM_API_KEY=
LLM_BASE_URL=https://llm.cs.cityu.edu.hk/v1
LLM_MODEL=CS5351/DeepSeek-V4-Flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1200
# Leave blank for the school gateway; direct DeepSeek supports disabled/enabled.
LLM_THINKING=
LLM_JSON_MODE=true
RAG_TOP_K=5
# Keep B's current defaults until the team agrees to change them.
RAG_COLLECTION=fixed_150
RAG_ARM=enhanced
RAG_EXPERIMENT_DIR=data/experiments/phase26_reproduction
RAG_MODEL_CACHE=.cache/huggingface/hub
# Empty = no uncalibrated distance cutoff. Set only after development calibration.
RAG_MAX_DISTANCE=
