# Copy to .env locally. Never commit real credentials.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1200
# Direct DeepSeek supports disabled/enabled. Leave blank for other gateways.
LLM_THINKING=disabled
LLM_JSON_MODE=true
# Use joint_pairs8 to opt into the reviewed eight-block, two-stage demo profile.
RAG_DEMO_PROFILE=baseline
# Separate acceptance profile: ofox_joint_pairs8. Requires explicit consent and
# the fixed durable registry described in docs/live_demo_acceptance_plan.md.
# OfoxAI settings are pinned by that profile; no DeepSeek thinking field is sent.
OFOX_API_KEY=
RAG_TOP_K=5
# Keep B's current defaults until the team agrees to change them.
RAG_COLLECTION=fixed_150
RAG_ARM=enhanced
RAG_EXPERIMENT_DIR=data/experiments/phase26_reproduction
RAG_MODEL_CACHE=.cache/huggingface/hub
# Empty = no uncalibrated distance cutoff. Set only after development calibration.
RAG_MAX_DISTANCE=
